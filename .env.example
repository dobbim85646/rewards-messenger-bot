# Server & Port
PORT=3000

# Gemini API
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_STRONG_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_STRONG_THINKING_LEVEL=medium
GEMINI_TIMEOUT_MS=20000
GEMINI_MEDIA_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_STRONG_MAX_OUTPUT_TOKENS=3072
GEMINI_MAX_RETRIES=0

# Facebook Messenger
VERIFY_TOKEN=
PAGE_ACCESS_TOKEN=
APP_SECRET=
ADMIN_TOKEN=
GRAPH_API_VERSION=v24.0

# Optional Database (PostgreSQL) - if omitted, in-memory store is used
DATABASE_URL=

# Quotas & Limits
DAILY_USER_LIMIT=50
DAILY_MEDIA_LIMIT=10
DAILY_STRONG_LIMIT=5
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW=60
MAX_CONTEXT_MESSAGES=12
MAX_STORED_MESSAGES=30
RETENTION_DAYS=90
SHOW_STATUS_MESSAGES=true
FETCH_META_PROFILE=true
ENABLE_SEARCH=true
SEARCH_MODE=auto
